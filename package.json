{
  "name": "fieldlens",
  "version": "2.1.0",
  "private": true,
  "description": "Local crop image classification and pest detection",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "prepare-runtime": "node scripts/prepare-runtime.js",
    "desktop": "electron .",
    "desktop:build": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "onnxruntime-web": "1.20.1"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.fieldlens.desktop",
    "productName": "FieldLens",
    "copyright": "FieldLens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/style.css",
      "dist/app.js",
      "dist/engine.js",
      "dist/example-corn.jpg",
      "dist/favicon.svg",
      "dist/mascot.webp",
      "desktop-ui/**",
      "dist/runtime/**",
      "desktop/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "FieldLens-Setup-2.1.0-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FieldLens"
    }
  }
}
